# Jira REST credentials for the Jira pull (POST /api/pull/jira).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
# Copy this file to .env — .env is gitignored, .env.example is not.
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# Google Calendar (POST /api/pull/calendar) — pick ONE of the two.
#
# 1. Service account (no browser, no expiry). Create one in the Cloud console, download its
#    JSON key, keep it OUTSIDE this repo, then share each calendar with its client_email
#    under Calendar settings → "Share with specific people".
GOOGLE_SERVICE_ACCOUNT_KEY=/absolute/path/to/google-sa.json
#
# 2. Installed-app OAuth — needed for calendars you cannot share (a team calendar someone
#    else owns). Run `npm run google-auth` once; it writes GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
