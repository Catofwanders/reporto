#!/bin/sh
# Blocks a push that would carry employer-confidential words to a public remote.
#
# Wired with:  git config core.hooksPath .githooks
#
# git feeds one line per ref on stdin: "<local ref> <local sha> <remote ref> <remote sha>".
# The remote sha is all zeros for a branch the remote does not have yet, and there is no
# range to diff — so that case falls back to sweeping every tracked file.
set -e

zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a ref carries nothing
  if [ "$remote_sha" = "$zero" ]; then
    node scripts/nda-scan.mjs --tracked || status=1
  else
    node scripts/nda-scan.mjs --range "$remote_sha..$local_sha" || status=1
  fi
done

if [ "$status" != 0 ]; then
  echo "pre-push: refused. Fix the findings above; --no-verify is not the answer." >&2
  exit 1
fi
