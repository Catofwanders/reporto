{
  "$comment": "Copy to ./config/projects.json and describe your own work. ./config is gitignored, so repo names, systems and anything employer-specific stay off the remote. Everything below is an invented online marketplace, deliberately unrelated to any real project.",
  "projects": [
    {
      "id": "web",
      "name": "marketplace-shop-web",
      "title": "Buyer storefront",
      "what": "What buyers browse and check out in. The surface most tickets land on.",
      "stack": [
        "React 19",
        "npm",
        "Node 20"
      ],
      "role": "client",
      "base": "deploy-qc",
      "url": "https://github.com/your-org/marketplace-shop-web",
      "consumes": [
        "graph"
      ],
      "flows": [
        {
          "id": "checkout",
          "title": "Buyer checkout",
          "what": "Basket to paid order: stock reserved, card authorised, receipt sent. Invented — replace with yours.",
          "source": "src/checkout/",
          "actors": [
            {
              "id": "buyer",
              "label": "Buyer"
            },
            {
              "id": "shop",
              "label": "Storefront"
            },
            {
              "id": "api",
              "label": "Orders API"
            },
            {
              "id": "pay",
              "label": "Payments"
            }
          ],
          "steps": [
            {
              "id": "basket",
              "actor": "buyer",
              "label": "Adds items to the basket",
              "ref": null
            },
            {
              "id": "start",
              "actor": "shop",
              "label": "Starts checkout",
              "ref": "POST /baskets/:id/checkout"
            },
            {
              "id": "reserve",
              "actor": "api",
              "label": "Reserves the stock",
              "ref": "state: reserved"
            },
            {
              "id": "charge",
              "actor": "pay",
              "label": "Authorises the card",
              "ref": "payments: authorize"
            },
            {
              "id": "confirm",
              "actor": "api",
              "label": "Confirms the order",
              "ref": "state: paid"
            },
            {
              "id": "receipt",
              "actor": "api",
              "label": "Sends the receipt",
              "ref": "template: order-receipt"
            },
            {
              "id": "fulfil",
              "actor": "api",
              "label": "Queues fulfilment",
              "ref": "queue: fulfilment"
            }
          ]
        },
        {
          "id": "listing",
          "title": "Listing goes live",
          "what": "A seller posts a product: draft, validation, moderation, then publication to the search index. Invented — replace with yours.",
          "source": "src/listings/",
          "actors": [
            {
              "id": "seller",
              "label": "Seller"
            },
            {
              "id": "console",
              "label": "Seller console"
            },
            {
              "id": "api",
              "label": "Catalog API"
            },
            {
              "id": "worker",
              "label": "Worker"
            }
          ],
          "steps": [
            {
              "id": "draft",
              "actor": "seller",
              "label": "Starts a draft listing",
              "ref": null
            },
            {
              "id": "save",
              "actor": "console",
              "label": "Saves as it goes",
              "ref": "PUT /listings/:id"
            },
            {
              "id": "submit",
              "actor": "seller",
              "label": "Submits for review",
              "ref": null
            },
            {
              "id": "queue",
              "actor": "api",
              "label": "Queues moderation",
              "ref": "state: in-review"
            },
            {
              "id": "checks",
              "actor": "worker",
              "label": "Runs the checks",
              "ref": "queue: listing-moderation"
            },
            {
              "id": "publish",
              "actor": "api",
              "label": "Publishes the listing",
              "ref": "state: live"
            },
            {
              "id": "index",
              "actor": "worker",
              "label": "Indexes it for search",
              "ref": "queue: search-index"
            }
          ]
        }
      ]
    },
    {
      "id": "admin",
      "name": "marketplace-seller-console",
      "title": "Seller console",
      "what": "Where sellers manage listings, orders and payouts.",
      "stack": [
        "React 18",
        "pnpm",
        "Node 20"
      ],
      "role": "client",
      "url": "https://github.com/your-org/marketplace-seller-console",
      "consumes": [
        "graph"
      ]
    },
    {
      "id": "graph",
      "name": "marketplace-catalog-api",
      "title": "Catalog API",
      "what": "One schema in front of the services. Clients generate types from it.",
      "stack": [
        "Apollo",
        "npm",
        "Node 18"
      ],
      "role": "service",
      "url": "https://github.com/your-org/marketplace-catalog-api",
      "consumes": [
        "core"
      ]
    },
    {
      "id": "core",
      "name": "marketplace-orders-core",
      "title": "Orders core",
      "what": "Baskets, orders and payouts, and the database of record.",
      "stack": [
        "TypeScript",
        "pnpm workspace",
        "Postgres"
      ],
      "role": "service",
      "url": "https://github.com/your-org/marketplace-orders-core"
    }
  ],
  "workflow": {
    "note": "deploy-qc is shared and resettable: a merge is not proof the change is on QC.",
    "stages": [
      {
        "id": "todo",
        "label": "Backlog",
        "note": "not started",
        "statuses": [
          "Backlog",
          "Selected"
        ]
      },
      {
        "id": "dev",
        "label": "In progress",
        "note": "branch off, ticket key in the name",
        "statuses": [
          "In Progress"
        ]
      },
      {
        "id": "review",
        "label": "Code review",
        "note": "PR opened against deploy-qc",
        "statuses": [
          "In Review"
        ]
      },
      {
        "id": "qc",
        "label": "QC",
        "note": "merged into deploy-qc; QC tests there",
        "statuses": [
          "Testing",
          "Test Failed"
        ]
      },
      {
        "id": "signoff",
        "label": "Sign-off",
        "note": "client approves",
        "statuses": [
          "Approved"
        ]
      },
      {
        "id": "release",
        "label": "Release",
        "note": "merged to the release branch",
        "statuses": [
          "Ready to Release"
        ]
      }
    ]
  },
  "infra": {
    "note": "One entry per independent system. Separate stacks get separate diagrams, so a shared layer is never implied where there is none.",
    "systems": [
      {
        "id": "platform",
        "title": "Marketplace platform",
        "note": "High level only — what talks to what, not how it is deployed.",
        "layers": [
          "Clients",
          "Edge",
          "Services",
          "Data"
        ],
        "nodes": [
          {
            "id": "web",
            "label": "Buyer storefront",
            "layer": "Clients"
          },
          {
            "id": "admin",
            "label": "Seller console",
            "layer": "Clients"
          },
          {
            "id": "cdn",
            "label": "CDN",
            "note": "static hosting",
            "layer": "Edge"
          },
          {
            "id": "graph",
            "label": "Catalog API",
            "layer": "Edge"
          },
          {
            "id": "core",
            "label": "Orders core",
            "layer": "Services"
          },
          {
            "id": "jobs",
            "label": "Workers",
            "note": "queues and scheduled jobs",
            "layer": "Services"
          },
          {
            "id": "db",
            "label": "Postgres",
            "layer": "Data"
          },
          {
            "id": "files",
            "label": "Object storage",
            "layer": "Data"
          }
        ],
        "edges": [
          [
            "web",
            "cdn"
          ],
          [
            "web",
            "graph"
          ],
          [
            "admin",
            "graph"
          ],
          [
            "graph",
            "core"
          ],
          [
            "core",
            "jobs"
          ],
          [
            "core",
            "db"
          ],
          [
            "jobs",
            "db"
          ],
          [
            "core",
            "files"
          ]
        ]
      },
      {
        "id": "standalone",
        "title": "Standalone shop (self-contained)",
        "note": "Its own client, API and database. Nothing here reaches the marketplace platform.",
        "layers": [
          "Client",
          "Services",
          "Data"
        ],
        "nodes": [
          {
            "id": "ui",
            "label": "Web client",
            "layer": "Client"
          },
          {
            "id": "api",
            "label": "Own API server",
            "layer": "Services"
          },
          {
            "id": "cms",
            "label": "CMS",
            "note": "content",
            "layer": "Services"
          },
          {
            "id": "ownpg",
            "label": "Own Postgres",
            "layer": "Data"
          }
        ],
        "edges": [
          [
            "ui",
            "api"
          ],
          [
            "ui",
            "cms"
          ],
          [
            "api",
            "ownpg"
          ],
          [
            "cms",
            "ownpg"
          ]
        ]
      }
    ]
  }
}
